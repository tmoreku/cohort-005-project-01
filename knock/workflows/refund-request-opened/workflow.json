{
  "name": "Refund Request opened",
  "description": "A buyer opened a Refund Request. Sent to every Platform Admin.",
  "steps": [
    {
      "name": "Feed",
      "type": "channel",
      "template": {
        "action_url": "{{ data.url }}",
        "markdown_body@": "in-app-feed/markdown_body.md"
      },
      "ref": "in-app-feed",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    },
    {
      "name": "Email",
      "type": "channel",
      "template": {
        "subject": "Refund request: {{ data.courseTitle }} ({{ data.amount }})",
        "settings": {
          "layout_key": "cadence",
          "attachment_key": "attachments",
          "pre_content@": "email/pre_content.txt"
        },
        "html_body@": "email/html_body.html"
      },
      "ref": "email",
      "channel_type": "email",
      "channel_key": "email-resend"
    },
    {
      "name": "Web push",
      "type": "channel",
      "template": {
        "settings": {
          "delivery_type": "content",
          "payload_overrides@": "push/settings/payload_overrides.json"
        },
        "title@": "push/title.txt",
        "text_body@": "push/text_body.txt"
      },
      "ref": "push",
      "channel_type": "push",
      "channel_key": "web-push-fcm"
    }
  ],
  "trigger_data_json_schema": {
    "$defs": {
      "actor": {
        "properties": {
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      }
    },
    "properties": {
      "actor": {
        "$ref": "#/$defs/actor"
      },
      "amount": {
        "type": "string"
      },
      "boughtAt": {
        "format": "date-time",
        "type": "string"
      },
      "buyerEmail": {
        "type": "string"
      },
      "buyerName": {
        "type": "string"
      },
      "courseTitle": {
        "type": "string"
      },
      "purchaseType": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "requestedAt": {
        "format": "date-time",
        "type": "string"
      },
      "url": {
        "type": "string"
      }
    },
    "required": [
      "url",
      "actor",
      "buyerName",
      "buyerEmail",
      "courseTitle",
      "amount",
      "purchaseType",
      "reason",
      "boughtAt",
      "requestedAt"
    ],
    "type": "object"
  },
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "refund-request-opened",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
