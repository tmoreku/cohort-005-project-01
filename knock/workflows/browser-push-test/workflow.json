{
  "name": "Browser push test",
  "description": "\"Send a test notification\" on Settings → Browser notifications. Not a Notification: web push only, whatever the person's Notification Preferences say.",
  "steps": [
    {
      "name": "Web push",
      "type": "channel",
      "template": {
        "settings": {
          "delivery_type": "content",
          "payload_overrides@": "push/settings/payload_overrides.json"
        },
        "title@": "push/title.txt",
        "text_body@": "push/text_body.txt"
      },
      "ref": "push",
      "channel_type": "push",
      "channel_key": "web-push-fcm"
    }
  ],
  "settings": {
    "override_preferences": true,
    "is_commercial": false
  },
  "trigger_data_json_schema": {
    "properties": {
      "url": {
        "type": "string"
      }
    },
    "required": [
      "url"
    ],
    "type": "object"
  },
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "browser-push-test",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
